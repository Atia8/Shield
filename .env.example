# Copy to .env.local and fill in. EXPO_PUBLIC_ values are bundled into the app (not secret).

# Claude API key for the AI Safety Companion (console.anthropic.com).
# Leave empty to use built-in offline guidance.
CLAUDE_API_KEY=

# Number dialled by the "Call 999" buttons.
EXPO_PUBLIC_EMERGENCY_NUMBER=999

# true = helper verification is approved right after submission (demo / presentation).
# false = an admin approves in the Firebase console (see README).
EXPO_PUBLIC_DEMO_AUTO_VERIFY=false
